# ---- 模型服务（OpenAI 兼容接口）----
# 不填 LLM_API_KEY 时，应用会自动进入「离线演示模式」，功能可完整体验
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 可选参数（保持默认即可）----
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=25
MAX_TOOL_ROUNDS=3
MAX_TOKENS=1200

# ---- 实验性功能，默认关闭 ----
ENABLE_VECTOR=0

# ---- 日志级别：DEBUG / INFO / WARNING ----
LOG_LEVEL=INFO
