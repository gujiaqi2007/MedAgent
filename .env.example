# 复制本文件为 .env 并填写你的 API Key（.env 已被 .gitignore 忽略，不会提交）
# 支持任意 OpenAI 兼容服务（DeepSeek / SiliconFlow / OpenAI 等）

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：AI 语音合成（TTS）
# AI_VOICE_API_KEY=
# AI_VOICE_BASE_URL=https://api.openai.com/v1
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=alloy
