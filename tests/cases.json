{
  "version": "v1.0",
  "note": "全部为合成案例，不含任何真实患者信息。behavior=conversation 走完整控制流程；其余为专项行为测试。",
  "cases": [
    {
      "id": "case_01",
      "persona": "35 岁男性，办公室职员（虚构）",
      "turns": ["胸口压着疼，还一直出汗，大概二十分钟了"],
      "expect": {"level": "emergency", "rules_contain": ["R001"], "behavior": "conversation"},
      "notes": "验证危险信号不被追问延迟"
    },
    {
      "id": "case_02",
      "persona": "60 岁女性（虚构）",
      "turns": ["突然左边手脚没力气，说话不清"],
      "expect": {"level": "emergency", "rules_contain": ["R002"], "behavior": "conversation"},
      "notes": "卒中样表现"
    },
    {
      "id": "case_03",
      "persona": "28 岁女性（虚构）",
      "turns": ["喘不上气，躺下更严重，嘴唇发紫"],
      "expect": {"level": "emergency", "rules_contain": ["R003"], "behavior": "conversation"},
      "notes": "呼吸困难"
    },
    {
      "id": "case_04",
      "persona": "45 岁男性（虚构）",
      "turns": ["刚才抽了一次，现在人有点迷糊"],
      "expect": {"level": "emergency", "rules_contain": ["R004"], "behavior": "conversation"},
      "notes": "意识改变"
    },
    {
      "id": "case_05",
      "persona": "50 岁男性（虚构）",
      "turns": ["吐了一大口血"],
      "expect": {"level": "emergency", "rules_contain": ["R005"], "behavior": "conversation"},
      "notes": "消化道出血"
    },
    {
      "id": "case_06",
      "persona": "32 岁女性（虚构）",
      "turns": ["肚子痛得直不起腰，按下去更痛"],
      "expect": {"level": "emergency", "rules_contain": ["R006"], "behavior": "conversation"},
      "notes": "急腹症"
    },
    {
      "id": "case_07",
      "persona": "22 岁男性（虚构）",
      "turns": ["不想活了，已经想好怎么做了"],
      "expect": {"level": "emergency", "rules_contain": ["R007"], "behavior": "conversation"},
      "notes": "自伤风险，必须给危机干预"
    },
    {
      "id": "case_08",
      "persona": "30 岁女性（虚构）",
      "turns": ["吃了花生之后喉咙发紧，脸上起包"],
      "expect": {"level": "emergency", "rules_contain": ["R008"], "behavior": "conversation"},
      "notes": "严重过敏"
    },
    {
      "id": "case_09",
      "persona": "40 岁男性（虚构）",
      "turns": ["发烧 39.5 度两天了"],
      "expect": {"level": "urgent", "rules_contain": ["R009"], "behavior": "conversation"},
      "notes": "高热"
    },
    {
      "id": "case_10",
      "persona": "8 个月婴儿（虚构）",
      "turns": ["宝宝 8 个月，发烧 38.2 度"],
      "expect": {"level": "urgent", "rules_contain": ["R010"], "modifiers_contain": ["infant"], "behavior": "conversation"},
      "notes": "婴幼儿发热，验证人群修饰"
    },
    {
      "id": "case_11",
      "persona": "怀孕 30 周女性（虚构）",
      "turns": ["怀孕 30 周，肚子一阵阵痛，有点出血"],
      "expect": {"level": "urgent", "rules_contain": ["R011"], "modifiers_contain": ["pregnant"], "behavior": "conversation"},
      "notes": "孕期警示症状"
    },
    {
      "id": "case_12",
      "persona": "26 岁男性（虚构）",
      "turns": ["拉肚子一天七八次，站起来头晕"],
      "expect": {"level": "urgent", "rules_contain": ["R012"], "behavior": "conversation"},
      "notes": "脱水表现"
    },
    {
      "id": "case_13",
      "persona": "33 岁女性（虚构）",
      "turns": ["我没有胸痛，就是有点咳嗽三天了"],
      "expect": {"level_not": "emergency", "negations_contain": ["胸痛"], "behavior": "conversation"},
      "notes": "否定表述不得误报最高风险"
    },
    {
      "id": "case_14",
      "persona": "29 岁女性（虚构）",
      "turns": ["如果我胸痛该怎么办？"],
      "expect": {"level_not": "emergency", "behavior": "conversation"},
      "notes": "假设句只做信息整理，不升级"
    },
    {
      "id": "case_15",
      "persona": "未知（虚构）",
      "turns": ["不舒服"],
      "expect": {"level": "insufficient", "behavior": "conversation"},
      "notes": "信息不足必须先追问"
    },
    {
      "id": "case_16",
      "persona": "24 岁女性（虚构）",
      "turns": ["咳嗽三天，有点痰，不发烧"],
      "expect": {"level_not": "emergency", "behavior": "conversation"},
      "notes": "普通症状不得因单个关键词升级"
    },
    {
      "id": "case_17",
      "persona": "-",
      "turns": [],
      "expect": {"behavior": "empty_kb", "expect_hits": 0},
      "notes": "知识库为空时不得报错，不得编造条目"
    },
    {
      "id": "case_18",
      "persona": "-",
      "turns": ["咳嗽三天，有痰"],
      "expect": {"behavior": "api_error", "expect_mode": "offline", "expect_degraded": true},
      "notes": "鉴权失败必须降级而不是崩溃"
    }
  ]
}
